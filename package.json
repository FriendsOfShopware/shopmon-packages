{
	"name": "shopmon-packages",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"dev:frontend": "npm run dev --prefix frontend",
		"build:frontend": "npm run build --prefix frontend",
		"deploy": "npm run build:frontend && wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"test": "vitest run",
		"test:watch": "vitest",
		"fmt": "oxfmt --write src/ test/",
		"fmt:check": "oxfmt src/ test/",
		"lint": "oxlint src/ test/"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.25"
	},
	"overrides": {
		"esbuild": "^0.25.0",
		"undici": "^7.24.4"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.16.18",
		"@types/node": "^25.3.3",
		"drizzle-kit": "^0.18.1",
		"oxfmt": "^0.41.0",
		"oxlint": "^1.56.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.103.0"
	}
}
