// Local test configuration for the Vitest pool, which requires Wrangler JSON config.
{
  "name": "shopmon-packages",
  "main": "../src/index.ts",
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "packages-mirror",
      "database_id": "b0add9b3-5192-40aa-994f-60aba7aab9bf",
      "migrations_dir": "../drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PACKAGES_BUCKET",
      "bucket_name": "packages-mirror",
    },
  ],
  "queues": {
    "producers": [
      {
        "queue": "package-downloads",
        "binding": "DOWNLOAD_QUEUE",
      },
    ],
    "consumers": [
      {
        "queue": "package-downloads",
        "max_batch_size": 100,
        "max_concurrency": 5,
      },
    ],
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
  },
}
